{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "*.json",
      "*.ts",
      "!dist",
      "!node_modules",
      "!package-lock.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
